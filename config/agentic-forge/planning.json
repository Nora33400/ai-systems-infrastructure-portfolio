{
  "schema_version": "1.1",
  "model": "long_horizon_task_reference",
  "principles": {
    "source_of_truth": "root_task",
    "iterations_are_subtasks": true,
    "subtasks_reference_parent": true,
    "completed_iterations_remain_addressable": true,
    "replan_preserves_history": true,
    "network_default": "deny"
  },
  "task_types": [
    "task",
    "planning_task",
    "iteration",
    "sub_task",
    "discovery",
    "verification"
  ],
  "states": [
    "planned",
    "ready",
    "running",
    "blocked",
    "needs_replan",
    "review",
    "verified",
    "completed",
    "cancelled"
  ],
  "hierarchy": {
    "root": "Long reference / mission",
    "level_1": "phase",
    "level_2": "iteration",
    "level_3": "subtask",
    "level_4": "verification",
    "rule": "Every child stores parent_task_id and source_iteration_id when applicable."
  },
  "iteration_contract": {
    "id": "stable immutable id",
    "parent_task_id": "root or phase owner",
    "source_plan_version": "plan revision that created it",
    "objective": "bounded outcome",
    "inputs": [
      "context refs",
      "artifacts",
      "constraints"
    ],
    "outputs": [
      "artifact refs",
      "decision refs",
      "test refs"
    ],
    "dependencies": [
      "task ids"
    ],
    "acceptance": [
      "machine-checkable or human-approved criteria"
    ],
    "checkpoint": "persist before handoff",
    "replan_on": [
      "failure",
      "new constraint",
      "stale context",
      "dependency change"
    ]
  },
  "execution_loop": [
    "load_root_reference",
    "select_next_ready_subtask",
    "hydrate_context_from_parent_and_dependencies",
    "execute_in_isolated_workspace",
    "verify_outputs",
    "persist_iteration_checkpoint",
    "update_parent_progress",
    "replan_remaining_subtasks_if_needed",
    "continue_until_acceptance_or_human_stop"
  ],
  "context_policy": {
    "pass_full_history": false,
    "default": "reference_by_id",
    "hydrate": [
      "parent_summary",
      "active_constraints",
      "dependency_outputs",
      "latest_checkpoint",
      "relevant_artifacts"
    ],
    "archive": "immutable_iteration_record"
  },
  "parallelism": {
    "allowed": true,
    "only_when": "subtasks have no unresolved dependency edge and do not share mutable workspace state",
    "merge": "verification gate before parent progress"
  },
  "human_gates": {
    "required_for": [
      "permission.change",
      "external_network",
      "git.push",
      "github.write",
      "destructive_action",
      "final_merge"
    ],
    "agents_cannot_self_approve": true
  },
  "context_locality": {
    "enabled": true,
    "purpose": "Select the smallest useful contextual unit before expanding outward, preserving meaning while limiting context load.",
    "levels": [
      {
        "id": "L0",
        "name": "letter",
        "unit": "single character",
        "expand_to": "word"
      },
      {
        "id": "L1",
        "name": "word",
        "unit": "single token/word",
        "expand_to": "sentence"
      },
      {
        "id": "L2",
        "name": "sentence",
        "unit": "single sentence",
        "expand_to": "paragraph"
      },
      {
        "id": "L3",
        "name": "paragraph",
        "unit": "single paragraph",
        "expand_to": "paragraph_series"
      },
      {
        "id": "L4",
        "name": "paragraph_series",
        "unit": "2, 4, or more contiguous/referenced paragraphs",
        "expand_to": "short_file"
      },
      {
        "id": "L5",
        "name": "short_file",
        "unit": "short file",
        "expand_to": "medium_file"
      },
      {
        "id": "L6",
        "name": "medium_file",
        "unit": "medium file",
        "expand_to": "long_file"
      },
      {
        "id": "L7",
        "name": "long_file",
        "unit": "long file",
        "expand_to": "repository_scope"
      }
    ],
    "selection_rule": "Start at the smallest locality that can answer or execute the current subtask; expand only when acceptance criteria, references, dependencies, or ambiguity require additional context.",
    "reference_strategy": {
      "default": "reference_by_id_and_span",
      "preserve_location": "file_id + section/paragraph/sentence/offset when available",
      "avoid_full_history": true,
      "cross_locality": "child context may reference a narrower span inside a broader parent artifact"
    },
    "expansion_triggers": [
      "insufficient semantic context",
      "cross_sentence dependency",
      "cross_paragraph dependency",
      "definition/reference outside current span",
      "acceptance criterion requires broader artifact",
      "verification needs neighboring or whole-file structure"
    ],
    "contraction_rule": "After expansion, return to the smallest sufficient locality for the next action.",
    "integrity_rules": [
      "do not silently merge unrelated spans",
      "preserve source offsets or stable anchors when possible",
      "record expanded locality in the iteration checkpoint",
      "locality never overrides explicit security or human-approval gates"
    ]
  }
}
