{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aione.local/schemas/hci.schema.json",
  "title": "HCI Program AST",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "language", "program", "statements", "sourceHash"],
  "properties": {
    "schema": {"const": "aione.hci-program.v1"},
    "language": {"const": "HCI/0.1"},
    "program": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "statements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "arguments", "line"],
        "properties": {
          "kind": {"enum": ["context", "represent", "model", "hypothesis", "verify", "select", "persist", "simulate"]},
          "name": {"type": "string"},
          "arguments": {"type": "object"},
          "line": {"type": "integer", "minimum": 1}
        }
      }
    },
    "sourceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
