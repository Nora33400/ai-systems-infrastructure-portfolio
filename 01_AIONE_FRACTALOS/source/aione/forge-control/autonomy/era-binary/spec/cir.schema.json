{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aione.local/schemas/cir.schema.json",
  "title": "Cognitive Intermediate Representation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "program", "sourceHash", "instructions", "resources", "security", "metadata", "cirHash"],
  "properties": {
    "schema": {"const": "aione.cir.v1"},
    "program": {"type": "string"},
    "sourceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cirHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "instructions": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/instruction"}},
    "resources": {"$ref": "#/$defs/resources"},
    "security": {"$ref": "#/$defs/security"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "opcode", "artifact", "arguments", "dependencies", "contract", "sourceLine"],
      "properties": {
        "id": {"type": "string"},
        "opcode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "artifact": {"type": "string"},
        "arguments": {"type": "object"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["simulationOnly", "sideEffects", "reversible", "timeoutMs", "maxOutputBytes"],
          "properties": {
            "simulationOnly": {"const": true},
            "sideEffects": {"const": "NONE"},
            "reversible": {"const": true},
            "timeoutMs": {"type": "integer", "minimum": 1},
            "maxOutputBytes": {"type": "integer", "minimum": 1}
          }
        },
        "sourceLine": {"type": "integer", "minimum": 1}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuThreadsMax", "ramBytesMax", "vramBytesMax", "wallClockMsMax"],
      "properties": {
        "cpuThreadsMax": {"type": "integer", "minimum": 1},
        "ramBytesMax": {"type": "integer", "minimum": 1},
        "vramBytesMax": {"type": "integer", "minimum": 0},
        "wallClockMsMax": {"type": "integer", "minimum": 1}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "filesystem", "processExecution", "permissionExpansion"],
      "properties": {
        "network": {"const": "DENY"},
        "filesystem": {"const": "SIMULATION_ONLY"},
        "processExecution": {"const": "DENY"},
        "permissionExpansion": {"const": "DENY"}
      }
    }
  }
}
