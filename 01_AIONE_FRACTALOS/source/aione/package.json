{
  "name": "aione-fractal-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.fractalui.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.fractalui.json --noEmit",
    "lint": "tsc -p tsconfig.fractalui.json --noEmit",
    "test": "vitest run --config vitest.config.mjs",
    "test:e2e": "playwright test",
    "forge:build:guarded": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-aione-guarded.ps1",
    "forge:dev": "node --no-warnings forge-control/server.mjs",
    "forge:start": "node --no-warnings forge-control/server.mjs",
    "forge:gateway:start": "node --no-warnings forge-control/local-ai-gateway.mjs",
    "forge:gateway:test": "node --test forge-control/local-ai-gateway.test.mjs",
    "forge:health": "node forge-control/tools/health.mjs",
    "forge:audit": "node forge-control/tools/audit.mjs",
    "forge:backup": "node forge-control/tools/backup.mjs",
    "forge:autonomy:status": "node --no-warnings forge-control/autonomy/cli.mjs status",
    "forge:autonomy:audit": "node --no-warnings forge-control/autonomy/cli.mjs audit",
    "forge:autonomy:cycle": "node --no-warnings forge-control/autonomy/cli.mjs cycle",
    "forge:autonomy:refill-backlog": "node --no-warnings forge-control/autonomy/cli.mjs refill-backlog",
    "forge:immune:status": "node --no-warnings forge-control/autonomy/immune-cli.mjs status",
    "forge:immune:doctor": "node --no-warnings forge-control/autonomy/immune-cli.mjs doctor",
    "forge:immune:cycle": "node --no-warnings forge-control/autonomy/immune-cli.mjs cycle --apply-safe",
    "forge:immune:autoupgrade": "node --no-warnings forge-control/autonomy/immune-cli.mjs autoupgrade",
    "forge:autonomy:backup": "node --no-warnings forge-control/autonomy/cli.mjs backup",
    "forge:autonomy:test": "node --test forge-control/autonomy/autonomy.test.mjs",
    "forge:digital-life:status": "node --no-warnings forge-control/autonomy/digital-life-cli.mjs status",
    "forge:digital-life:brief": "node --no-warnings forge-control/autonomy/digital-life-cli.mjs brief",
    "forge:digital-life:test": "node --test forge-control/autonomy/digital-life.test.mjs",
    "forge:control-plane:status": "node --no-warnings forge-control/autonomy/control-plane-cli.mjs status",
    "forge:control-plane:audit": "node --no-warnings forge-control/autonomy/control-plane-cli.mjs audit",
    "forge:control-plane:inventory": "node --no-warnings forge-control/autonomy/control-plane-cli.mjs inventory",
    "forge:control-plane:lists": "node --no-warnings forge-control/autonomy/control-plane-cli.mjs lists",
    "forge:control-plane:test": "node --test forge-control/autonomy/control-plane.test.mjs",
    "forge:ecosystem:test": "node --no-warnings --test forge-control/autonomy/ecosystem-fabric.test.mjs",
    "forge:automations:list": "node --no-warnings forge-control/autonomy/automation-cli.mjs list",
    "forge:dual-gpu:test": "node --test forge-control/autonomy/continuous-development-worker.test.mjs",
    "forge:dual-gpu:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/get-dual-gpu-development-status.ps1",
    "forge:implementation:test": "node --test forge-control/autonomy/isolated-implementation.test.mjs",
    "forge:implementation:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/get-isolated-implementation-status.ps1",
    "forge:learning:test": "node --test forge-control/autonomy/user-learning-planner.test.mjs",
    "forge:learning:prepare": "node --no-warnings forge-control/autonomy/user-learning-planner.mjs",
    "forge:week-soak:test": "node --test forge-control/autonomy/week-soak-analyzer.test.mjs",
    "forge:week-soak:status": "node --no-warnings forge-control/autonomy/week-soak-cli.mjs status",
    "forge:week-soak:report": "node --no-warnings forge-control/autonomy/week-soak-cli.mjs report",
    "forge:observation:once": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-continuous-observation.ps1",
    "forge:observation:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/status-continuous-observation.ps1",
    "forge:research:status": "node --no-warnings forge-control/autonomy/controlled-research-cli.mjs status",
    "forge:research:simulate": "node --no-warnings forge-control/autonomy/controlled-research-cli.mjs simulate",
    "forge:research:cycle": "node --no-warnings forge-control/autonomy/controlled-research-cli.mjs cycle",
    "forge:research:test": "node --test forge-control/autonomy/controlled-research-lab.test.mjs forge-control/autonomy/controlled-research-cli.test.mjs",
    "forge:model-evolution:status": "node --no-warnings forge-control/autonomy/model-evolution-cli.mjs status",
    "forge:model-evolution:handoff": "node --no-warnings forge-control/autonomy/model-evolution-cli.mjs handoff",
    "forge:model-evolution:test": "node --test forge-control/autonomy/capability-ladder.test.mjs forge-control/autonomy/cognitive-deliberation.test.mjs forge-control/autonomy/model-quality-router.test.mjs forge-control/autonomy/model-evolution-handoff.test.mjs forge-control/autonomy/local-model-benchmark.test.mjs",
    "forge:absolute-priority:status": "node --no-warnings forge-control/autonomy/absolute-priority-cli.mjs status",
    "forge:absolute-priority:test": "node --test forge-control/autonomy/absolute-priority-program.test.mjs forge-control/autonomy/continuous-development-worker.test.mjs",
    "forge:reflective-autonomy:test": "node --test forge-control/autonomy/reflective-autonomy.test.mjs aione_cognitive_engine/tests/reflective-engine.test.mjs forge-control/autonomy/continuous-development-worker.test.mjs forge-control/autonomy/isolated-implementation.test.mjs",
    "forge:context-authority:test": "node --no-warnings --test forge-control/autonomy/context-authority.test.mjs forge-control/autonomy/absolute-priority-program.test.mjs forge-control/autonomy/continuous-development-worker.test.mjs forge-control/autonomy/owner-review.test.mjs forge-control/autonomy/governance-service.test.mjs",
    "forge:context-authority:status": "node --no-warnings forge-control/autonomy/context-authority-cli.mjs status",
    "forge:context-authority:record-active": "node --no-warnings forge-control/autonomy/context-authority-cli.mjs record-active",
    "forge:reflective-governors:test": "node --test forge-control/autonomy/reflective-network-access.test.mjs forge-control/autonomy/resilience-manager.test.mjs forge-control/autonomy/cognitive-immune-system.test.mjs forge-control/autonomy/immune-runtime.test.mjs",
    "forge:hci:test": "node --test forge-control/autonomy/hci-runtime.test.mjs",
    "forge:hci:topology": "cd forge-control/autonomy/era-binary && python -m era_binary.cli topology",
    "forge:release:candidate": "node forge-control/tools/release-candidate.mjs",
    "forge:write-test": "node --no-warnings forge-control/tools/runtime-write-test.mjs",
    "forge:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-forge-tests.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cytoscape": "^3.30.4",
    "gsap": "^3.12.5",
    "pixi.js": "^8.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/cytoscape": "^3.21.8",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.171.0",
    "tsx": "4.23.1",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  }
}
