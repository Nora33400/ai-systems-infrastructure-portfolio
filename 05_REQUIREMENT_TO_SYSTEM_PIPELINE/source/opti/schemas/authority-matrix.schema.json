{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-cognitive-constitution.local/schemas/authority-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "constitution_version", "status", "ordering_semantics", "layers", "rules", "forbidden_rules", "validation_modes", "source_refs"],
  "properties": {
    "schema_version": {"const": 1}, "matrix_id": {"type": "string"}, "constitution_version": {"const": "0.1.0"}, "status": {"const": "FORMALIZED"},
    "ordering_semantics": {"const": "transformation_distance_from_original_not_authority_rank"},
    "layers": {"type": "array", "minItems": 9, "items": {"type": "object", "required": ["id", "order", "object_type", "role", "can_be_evidence", "may_only_propose"]}},
    "rules": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["id", "action", "actor_types", "target_types", "requirements"]}},
    "forbidden_rules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "actor_type", "action"]}},
    "validation_modes": {"type": "object"}, "source_refs": {"type": "array", "minItems": 1}
  }
}
