{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-cognitive-constitution.local/schemas/constitutional-axioms.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "constitution_version", "status", "axioms"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"type": "string"},
    "constitution_version": {"const": "0.1.0"},
    "status": {"const": "FORMALIZED"},
    "axioms": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "statement", "enforcement", "source_refs"], "properties": {"id": {"type": "string", "pattern": "^COG-CONST-[0-9]{3}$"}, "name": {"type": "string"}, "statement": {"type": "string", "minLength": 10}, "enforcement": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
  }
}
}
