{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-cognitive-constitution.local/schemas/gpt-cognitive-constitution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "constitution_id", "version", "status", "effective_date", "authority", "layer", "scope", "normative_artifacts", "protected_distinctions", "compatibility", "implementation", "source_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "constitution_id": {"const": "GPT-COGNITIVE-CONSTITUTION"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["FORMALIZED", "TESTED", "STABILIZED"]},
    "effective_date": {"type": "string"},
    "authority": {"type": "object", "required": ["decision_id", "source_refs"]},
    "layer": {"type": "object", "required": ["kind", "order", "is_llm", "is_agent", "is_tile", "description"], "properties": {"kind": {"const": "governance"}, "order": {"const": 0}, "is_llm": {"const": false}, "is_agent": {"const": false}, "is_tile": {"const": false}, "description": {"type": "string"}}, "additionalProperties": false},
    "scope": {"type": "object", "required": ["governs", "does_not_claim"]},
    "normative_artifacts": {"type": "object", "minProperties": 8, "additionalProperties": {"type": "string"}},
    "protected_distinctions": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["id", "concepts", "rule", "source_refs"]}},
    "compatibility": {"type": "object", "required": ["historical_baseline", "historical_answer", "historical_model_run", "backward_compatibility", "canonical_evidence_mutated"], "properties": {"canonical_evidence_mutated": {"const": false}}, "additionalProperties": true},
    "implementation": {"type": "object", "required": ["status", "components", "limitations"]},
    "source_refs": {"$ref": "#/$defs/sourceRefs"}
  },
  "$defs": {"sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+(?::L[0-9]+(?:-L[0-9]+)?)?$"}}}
}
