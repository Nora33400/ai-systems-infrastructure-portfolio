{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-cognitive-constitution.local/schemas/constitutional-state-machine.schema.json",
  "type": "object",
  "required": ["schema_version", "machine_id", "constitution_version", "status", "subject_type", "states", "transitions", "source_refs"],
  "properties": {
    "schema_version": {"const": 1}, "machine_id": {"type": "string"}, "constitution_version": {"const": "0.1.0"}, "status": {"const": "FORMALIZED"}, "subject_type": {"enum": ["claim", "cognitive_execution"]},
    "states": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id"]}},
    "transitions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "from", "to"]}},
    "forbidden_transitions": {"type": "array", "items": {"type": "object", "required": ["id", "from", "to", "reason"]}},
    "revision_policy": {"type": "object"}, "error_classes": {"type": "object"}, "resume_policy": {"type": "object"}, "historical_compatibility": {"type": "object"}, "source_refs": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
