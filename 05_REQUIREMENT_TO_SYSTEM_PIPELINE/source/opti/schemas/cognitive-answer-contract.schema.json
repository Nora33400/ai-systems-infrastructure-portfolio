{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpt-cognitive-constitution.local/schemas/cognitive-answer-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "constitution_version", "status", "answer_statuses", "required_fields", "assertion_requirements", "decision_rules", "historical_adapter", "source_refs"],
  "properties": {
    "schema_version": {"const": 1}, "contract_id": {"type": "string"}, "constitution_version": {"const": "0.1.0"}, "status": {"const": "FORMALIZED"},
    "answer_statuses": {"type": "array", "minItems": 9, "items": {"type": "object", "additionalProperties": false, "required": ["id", "execution_failure", "meaning"], "properties": {"id": {"enum": ["ANSWERED", "PARTIALLY_ANSWERED", "UNKNOWN", "INSUFFICIENT_CONTEXT", "DEPENDENCY_MISSING", "AMBIGUOUS", "CONTRADICTORY_EVIDENCE", "UNSUPPORTED_REQUEST", "FAILED"]}, "execution_failure": {"type": "boolean"}, "meaning": {"type": "string"}}}},
    "required_fields": {"type": "array", "minItems": 10, "uniqueItems": true}, "assertion_requirements": {"type": "object"},
    "decision_rules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "when", "result"]}},
    "historical_adapter": {"type": "object", "required": ["legacy_schema", "answer_id", "mapped_status", "rationale", "forbidden_alternative", "source_refs"]}, "source_refs": {"type": "array", "minItems": 1}
  }
}
