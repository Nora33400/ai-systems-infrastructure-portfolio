{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aione.local/schemas/cognitive-relation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relation_id", "from", "to", "relation_type", "provenance", "confidence", "justification", "status", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "relation_id": {"type": "string", "pattern": "^REL-[A-F0-9]{16}$"},
    "from": {"type": "string", "minLength": 1},
    "to": {"type": "string", "minLength": 1},
    "relation_type": {"enum": ["derived_from", "contains", "supports", "contradicts", "depends_on", "clarifies", "replaces", "example_of", "implies", "implements", "used_in_response"]},
    "provenance": {"type": "object"},
    "confidence": {"enum": ["low", "medium", "high"]},
    "justification": {"type": "string", "minLength": 1},
    "status": {"enum": ["explicit_structure", "source_explicit", "generated", "inferred", "rejected"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
